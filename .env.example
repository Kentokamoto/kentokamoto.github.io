# Strava API credentials. The site build does NOT use these — it reads cached
# activity data from the strava-art Worker (STRAVA_ART_INDEX_URL below). They
# are for scripts/strava-token.mjs and for the Worker (workers/strava-art: put
# them in its .dev.vars locally, `wrangler secret put` when deployed).
#
# 1. Create an API application at https://www.strava.com/settings/api
#    -> gives you Client ID + Client Secret.
# 2. Mint a refresh token with scope `activity:read_all`:
#    node --env-file=.env scripts/strava-token.mjs authorize|exchange

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# The strava-art Worker's /art.json (cached #stravaart activities). Set as a
# Cloudflare *build* variable. Without it the page shows a link to Strava.
STRAVA_ART_INDEX_URL=

# Local testing only: build from a saved copy of /art.json instead, e.g.
#   curl -s localhost:8787/art.json > fixtures/art.local.json
# STRAVA_FIXTURE=fixtures/art.local.json
