# Strava API credentials for the build-time route-art fetch (StravaArt page).
# Without these, the Strava Art page falls back to the legacy embeds.
#
# 1. Create an API application at https://www.strava.com/settings/api
#    -> gives you Client ID + Client Secret.
# 2. Do a one-time OAuth with scope `activity:read_all` for your own account
#    to obtain a refresh token (the token exchange returns access + refresh).
# 3. Set these as build/CI secrets (e.g. Cloudflare Pages env vars). They are
#    read only at build time and never shipped to the browser.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
